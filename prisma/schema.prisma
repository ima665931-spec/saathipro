generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String    @default("USER")
  phone         String?
  isBanned      Boolean   @default(false)
  paymentStatus String    @default("NONE")
  /// WEEKLY | MONTHLY | HALF_YEAR | YEARLY
  plan          String?
  planExpiresAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  saathiProfile SaathiProfile?
  bookingsAsClient  Booking[] @relation("ClientBookings")
  bookingsAsSaathi  Booking[] @relation("SaathiBookings")
  reviewsGiven      Review[]  @relation("ReviewsGiven")
  reviewsReceived   Review[]  @relation("ReviewsReceived")
  payments          Payment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SaathiProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  bio         String?
  city        String?
  services    String?
  hourlyRate  Int?
  isVerified  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Booking {
  id            String   @id @default(cuid())
  clientId      String
  saathiId      String
  saathiName    String
  service       String
  city          String?
  date          String
  time          String
  durationHours Int      @default(1)
  amount        Int
  status        String   @default("PENDING")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client User @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  saathi User @relation("SaathiBookings", fields: [saathiId], references: [id], onDelete: Cascade)
  review Review?
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  clientId  String
  saathiId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client  User    @relation("ReviewsGiven", fields: [clientId], references: [id], onDelete: Cascade)
  saathi  User    @relation("ReviewsReceived", fields: [saathiId], references: [id], onDelete: Cascade)
}

model Payment {
  id         String   @id @default(cuid())
  userId     String
  amount     Int      @default(499)
  type       String   @default("MEMBERSHIP")
  /// WEEKLY | MONTHLY | HALF_YEAR | YEARLY
  plan       String?
  utr        String?
  screenshot String?
  status     String   @default("PENDING")
  note       String?
  upiPoolId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  upiPool UpiPool? @relation(fields: [upiPoolId], references: [id], onDelete: SetNull)
}

model UpiPool {
  id           String   @id @default(cuid())
  upiId        String   @unique
  displayName  String   @default("SaathiPro")
  isActive     Boolean  @default(true)
  dailyLimit   Int      @default(50)
  usedToday    Int      @default(0)
  lastResetAt  DateTime @default(now())
  priority     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments Payment[]
}
